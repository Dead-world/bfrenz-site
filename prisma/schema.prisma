generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  username     String @unique
  email        String @unique
  passwordHash String
  displayName  String

  headline String @default("")
  mood     String @default("")
  gender   String @default("")
  age      Int?
  location String @default("")
  birthMonth Int? // 1-12 (no year, so age stays private)
  birthDay   Int? // 1-31
  bdayPushYear Int? // last year frenz got the birthday notification (so it's sent once)

  aboutMe          String @default("")
  meet             String @default("")
  interestsGeneral String @default("")
  interestsMusic   String @default("")
  interestsMovies  String @default("")
  interestsTv      String @default("")
  interestsBooks   String @default("")
  interestsHeroes  String @default("")

  customCss  String @default("")
  avatarUrl  String @default("")
  songUrl    String @default("")
  songTitle  String @default("")
  songArtist String @default("")
  playlist   Json   @default("[]") // more songs after the main one: [{ url, title, artist }]
  songUpdatedAt DateTime? // when they last changed their profile song (shows in friends' feeds)

  profileViews   Int       @default(0)
  showCounter    Boolean   @default(false) // show the retro hit counter on their profile
  counterStyle   String    @default("")    // look of the hit counter (see lib/visitors.js)
  privateBrowsing Boolean  @default(false) // their visits don't show in "Who's been creeping"
  awayMessage    String    @default("")    // IM away message ("" = available)
  awaySince      DateTime?
  lastSeen       DateTime?
  createdAt      DateTime  @default(now())
  sessionVersion Int       @default(0) // bumped on password reset to log out old sessions

  // ---- money features ----
  theme              String    @default("") // slug of the shop theme applied to the profile
  aboutTemplate      String    @default("") // slug of the About Me template whose styles are applied
  aboutMeBackup      String    @default("") // their About Me from before they applied a template
  nameColor          String    @default("") // Supporter perk
  isArtist           Boolean   @default(false)
  genre              String    @default("")
  artistPro          Boolean   @default(false) // paid Pro Artist badge
  stripeCustomerId   String?
  stripeSubscription String?
  supporterUntil     DateTime? // Supporter perks active while this is in the future
  featuredUntil      DateTime? // paid "Featured" spot in Cool New People
  songBoostUntil     DateTime? // paid spot in Featured Music
  coins              Int       @default(0) // BFRENZ coins for sending gifts
  picFrame           String    @default("") // frame around their picture (lib/cosmetics.js)
  cursorFx           String    @default("") // cursor trail on their profile
  fallFx             String    @default("") // falling effect on their profile
  cosmetics          String[]  @default([]) // ones they own, e.g. "frame:fire", "cursor:hearts", "fall:snow"
  usernameChanges    Int       @default(0) // how many times they've changed their @username (first is free)
  inviteRewardPaid   Boolean   @default(false) // (on an invited member) their inviter already got coins for them
  design             Json? // "Design my profile" colors, font and corners (lib/design.js)
  bonusSupporterUntil DateTime? // free Supporter time earned from invites or gifted by a friend
  lifetimeSupporter  Boolean   @default(false) // bought Lifetime Supporter (never expires)
  isOfficial         Boolean   @default(false) // the site's own labeled bot account (BFRENZ Bot)
  creatorType        String    @default("") // creator mode: youtuber, streamer, ... ("" = regular member)
  creatorLinks       Json      @default("[]") // "My Links" buttons: [{ url, label }]
  supportLinks       Json      @default("[]") // "Support me" buttons: [{ kind, handle }] (Cash App, Venmo, PayPal…)
  supportNote        String    @default("") // a line above the support buttons
  profileLayout      Json? // box order on the profile: { left: [], right: [], hidden: [] } (null = default)
  nameEffect         String    @default("") // name effect showing on their name (lib/nameEffects.js)
  nameEffectsOwned   String[]  @default([]) // name effects they bought

  // ---- invites + moderation ----
  referredById String? // who invited this member (signup?ref=username)
  heardFrom    String  @default("") // "How did you hear about BFRENZ?" answer at sign-up
  signupSrc    String  @default("") // ?src= tag from the first link they came in on (e.g. bfrenz.com/?src=tiktok)
  bannedAt     DateTime? // suspended by an admin: can't log in, profile hidden
  banReason    String    @default("")

  passwordResets PasswordReset[]
  purchases      Purchase[]
  stickerOrders StickerOrder[]

  @@index([stripeSubscription])
  @@index([referredById])

  sentRequests     Friendship[] @relation("requester")
  receivedRequests Friendship[] @relation("addressee")
  topFriends       TopFriend[]  @relation("owner")
  inTopOf          TopFriend[]  @relation("friend")
  commentsReceived Comment[]    @relation("profile")
  commentsWritten  Comment[]    @relation("author")
  bulletins        Bulletin[]
  sentMessages     Message[]    @relation("sender")
  receivedMessages Message[]    @relation("recipient")
  photos           Photo[]
  albums           Album[]
  videos           Video[]
  imsSent          ChatMessage[] @relation("imFrom")
  imsReceived      ChatMessage[] @relation("imTo")
  posts            Post[]
  postComments     PostComment[]
  kudos            Kudos[]
  reactions        Reaction[]
  emojiReactions   EmojiReaction[]
  itemComments     ItemComment[]
  alerts           Alert[]
  oldUsernames     UsernameHistory[]
  giftsSent        Gift[]           @relation("giftFrom")
  giftsReceived    Gift[]           @relation("giftTo")
  pushSubs         PushSubscription[]
  visitsReceived   ProfileVisit[] @relation("visited")
  visitsMade       ProfileVisit[] @relation("visitor")
  surveyAnswers    SurveyAnswer[]
  blogPosts        BlogPost[]
  blogComments     BlogComment[]
  groupsOwned      Group[]       @relation("groupOwner")
  groupMemberships GroupMember[]
  groupPosts       GroupPost[]
  groupReplies     GroupReply[]
  potwVotesCast    PotwVote[]   @relation("potwVoter")
  potwVotesGot     PotwVote[]   @relation("potwNominee")
  potwWins         PotwWinner[]
  stampsGiven      StampGift[]  @relation("stampFrom")
  stampsGot        StampGift[]  @relation("stampTo")
  following        Follow[]     @relation("follower")
  followers        Follow[]     @relation("following")
  linkClicks       LinkClick[]
  mentions         Mention[]    @relation("mentioned")
  mentionsMade     Mention[]    @relation("mentioner")
  callsMade        VideoCall[]  @relation("callsMade")
  callsReceived    VideoCall[]  @relation("callsReceived")
  rtcSessions      RtcSession[]
  liveStreams      LiveStream[]
  liveWatches      LiveWatch[]
  liveChats        LiveChat[]
  blocksMade       Block[]      @relation("blocker")
  blocksReceived   Block[]      @relation("blocked")
  reportsMade      Report[]     @relation("reporter")
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING") // PENDING | ACCEPTED
  createdAt   DateTime @default(now())

  requester User @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model TopFriend {
  id       String @id @default(cuid())
  userId   String
  friendId String
  position Int

  user   User @relation("owner", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("friend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, position])
}

model Comment {
  id        String   @id @default(cuid())
  profileId String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  editedAt  DateTime? // set when the author edits it
  parentId  String? // set on replies; points at the top-level comment

  profile User      @relation("profile", fields: [profileId], references: [id], onDelete: Cascade)
  author  User      @relation("author", fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("replies")

  @@index([profileId, createdAt])
  @@index([parentId, createdAt])
}

model Bulletin {
  id             String    @id @default(cuid())
  authorId       String
  subject        String
  body           String
  createdAt      DateTime  @default(now())
  sponsoredUntil DateTime? // paid: shown to every member, labeled "Sponsored"

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([sponsoredUntil])
}

model Message {
  id               String   @id @default(cuid())
  senderId         String
  recipientId      String
  subject          String
  body             String
  read             Boolean  @default(false)
  senderDeleted    Boolean  @default(false)
  recipientDeleted Boolean  @default(false)
  createdAt        DateTime @default(now())

  sender    User @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  url       String
  caption   String   @default("")
  createdAt DateTime @default(now())
  albumId   String? // null = not in an album

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album? @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([albumId, createdAt])
}

model Album {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  coverUrl    String   @default("") // empty = use the newest photo
  createdAt   DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@index([userId, createdAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A real (mailed) sticker order. Created when Stripe confirms payment.
model StickerOrder {
  id              String    @id @default(cuid())
  userId          String
  slug            String    @default("bfrenz-logo")
  qty             Int
  amountCents     Int
  stripeSessionId String    @unique
  shipName        String    @default("")
  line1           String    @default("")
  line2           String    @default("")
  city            String    @default("")
  state           String    @default("")
  postal          String    @default("")
  country         String    @default("US")
  status          String    @default("paid") // paid | shipped | refunded
  tracking        String    @default("")
  shippedAt       DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

/// How many of a physical item are left (no row = not tracked).
model ShopStock {
  slug      String   @id
  stock     Int
  updatedAt DateTime @updatedAt
}

model Purchase {
  id              String   @id @default(cuid())
  userId          String
  kind            String // theme | supporter | pro_artist | feature | song_boost | sponsor_bulletin | tip
  itemId          String   @default("") // theme slug or bulletin id
  amountCents     Int
  stripeSessionId String   @unique
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id           String    @id @default(cuid())
  reporterId   String
  kind         String // profile | comment | bulletin | message | photo
  targetId     String // id of the reported thing (the user id for a profile)
  targetUserId String // who posted it
  reason       String
  details      String    @default("")
  status       String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedBy   String    @default("")
  note         String    @default("")

  reporter User @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([targetUserId])
}

model Video {
  id          String   @id @default(cuid())
  userId      String
  url         String   @default("") // uploaded file (Vercel Blob)
  youtubeId   String   @default("") // or a YouTube video
  title       String
  description String   @default("")
  onProfile   Boolean  @default(false) // shown in the Video box on their profile
  views       Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Instant messages (the bottom-right messenger). Separate from Mail.
model ChatMessage {
  id        String    @id @default(cuid())
  fromId    String
  toId      String
  body      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  from User @relation("imFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("imTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId, toId, createdAt])
  @@index([toId, readAt])
}

// ---- News feed ----
// A status post ("What's on your mind?") with optional photos, a video or a song link.
model Post {
  id         String   @id @default(cuid())
  authorId   String
  body       String   @default("")
  mood       String   @default("")
  imageUrls  String[] @default([])
  videoUrl   String   @default("") // uploaded video (Vercel Blob)
  youtubeId  String   @default("")
  visibility String @default("frenz") // frenz | public (creators can post publicly)
  songUrl    String   @default("")
  createdAt  DateTime @default(now())
  editedAt   DateTime? // set when the author edits the post
  boostUntil DateTime? // paid "Promoted" spot near the top of everyone's feed
  boostViews Int       @default(0) // times it was shown as Promoted

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments PostComment[]
  kudos    Kudos[]

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([boostUntil])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  editedAt  DateTime? // set when the author edits it
  parentId  String? // set on replies; always points at the top-level comment
  superCoins Int      @default(0) // Super Comment: coins paid to highlight it (0 = normal)
  superUntil DateTime? // pinned to the top of the post until this time

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  PostComment?  @relation("postCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("postCommentReplies")

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
}

// A ★ "kudos" on a post (one per person per post).
model Kudos {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

// A phone/computer that turned on notifications (Web Push). One person can have several.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Last time a member looked at someone's profile (one row per pair, updated on each visit).
model ProfileVisit {
  id        String   @id @default(cuid())
  profileId String
  visitorId String
  at        DateTime @default(now())
  hidden    Boolean  @default(false) // visited with private browsing on
  profile   User     @relation("visited", fields: [profileId], references: [id], onDelete: Cascade)
  visitor   User     @relation("visitor", fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([profileId, visitorId])
  @@index([profileId, at])
}

// A member's answers to one of the surveys in lib/surveys.js.
model SurveyAnswer {
  id         String   @id @default(cuid())
  surveySlug String
  userId     String
  answers    String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([surveySlug, userId])
  @@index([userId])
  @@index([surveySlug, createdAt])
  @@index([createdAt])
}

// ---------------- blogs ----------------
model BlogPost {
  id         String        @id @default(cuid())
  authorId   String
  title      String
  body       String        // HTML, cleaned like About Me
  mood       String        @default("")
  visibility String        @default("public") // public | frenz
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments   BlogComment[]

  @@index([authorId, createdAt])
  @@index([createdAt])
}

model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  editedAt  DateTime? // set when the author edits it
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// ---------------- groups ----------------
model Group {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String        @default("")
  category    String        @default("")
  avatarUrl   String        @default("")
  ownerId     String
  memberCount Int           @default(1)
  lastPostAt  DateTime?
  createdAt   DateTime      @default(now())
  owner       User          @relation("groupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  posts       GroupPost[]

  @@index([memberCount])
  @@index([createdAt])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("member") // owner | mod | member | banned
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupPost {
  id        String       @id @default(cuid())
  groupId   String
  authorId  String
  body      String
  imageUrl  String       @default("")
  pinned    Boolean      @default(false)
  createdAt DateTime     @default(now())
  group     Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies   GroupReply[]

  @@index([groupId, createdAt])
  @@index([authorId])
}

model GroupReply {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime? // set when the author edits it
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// ---------------- Profile of the Week ----------------
// week = the Monday it started (Eastern time), e.g. "2026-10-05"
model PotwVote {
  id        String   @id @default(cuid())
  week      String
  voterId   String
  nomineeId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  voter     User     @relation("potwVoter", fields: [voterId], references: [id], onDelete: Cascade)
  nominee   User     @relation("potwNominee", fields: [nomineeId], references: [id], onDelete: Cascade)

  @@unique([week, voterId])
  @@index([week, nomineeId])
}

model PotwWinner {
  id        String   @id @default(cuid())
  week      String   @unique
  userId    String
  votes     Int
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------- Stamps ----------------
// One of each stamp per giver per person (see lib/stamps.js for the catalog).
model StampGift {
  id        String   @id @default(cuid())
  stampSlug String
  fromId    String
  toId      String
  note      String   @default("")
  createdAt DateTime @default(now())
  from      User     @relation("stampFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("stampTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([stampSlug, fromId, toId])
  @@index([toId, createdAt])
  @@index([fromId, createdAt])
}

// ---------------- Creators ----------------
// Fans follow creators (one-way, no approval). Friendship is unchanged.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}

// A tap on one of a creator's "My Links" buttons (for their stats page).
model LinkClick {
  id        String   @id @default(cuid())
  ownerId   String
  label     String
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}

// Someone @mentioned a member in a post, comment or group wall post.
model Mention {
  id        String   @id @default(cuid())
  userId    String // who was mentioned
  fromId    String // who mentioned them
  kind      String // post | comment | grouppost | groupreply
  targetId  String // the post (or group post) it's in
  url       String
  snippet   String   @default("")
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation("mentioned", fields: [userId], references: [id], onDelete: Cascade)
  from      User     @relation("mentioner", fields: [fromId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([targetId])
}

// ---------------- video calls & live streams (video runs through Cloudflare Realtime) ----------------
// A 1-on-1 video call between frenz.
model VideoCall {
  id            String    @id @default(cuid())
  callerId      String
  calleeId      String
  status        String    @default("ringing") // ringing | active | ended | declined | missed
  offerSdp      String    @default("") // calls are direct (phone to phone): the caller's connection details
  answerSdp     String    @default("") // …and the answer from the person called
  callerSession String    @default("") // (unused since calls went direct; kept so old rows still load)
  calleeSession String    @default("")
  callerSeen    DateTime? // each side's call screen checks in every couple of seconds
  calleeSeen    DateTime?
  createdAt     DateTime  @default(now())
  answeredAt    DateTime?
  endedAt       DateTime?
  caller        User      @relation("callsMade", fields: [callerId], references: [id], onDelete: Cascade)
  callee        User      @relation("callsReceived", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([calleeId, status])
  @@index([callerId, status])
}

// Every Cloudflare session we open, so a browser can only use its own.
model RtcSession {
  id        String   @id // Cloudflare's session id
  userId    String
  purpose   String // call | live | watch
  refId     String // the call or stream it belongs to
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model LiveStream {
  id          String      @id @default(cuid())
  userId      String
  title       String      @default("")
  source      String      @default("browser") // browser (Cloudflare) | youtube | twitch | tiktok
  streamRef   String      @default("") // YouTube video id, Twitch channel or TikTok username
  sessionId   String      @default("") // Cloudflare session sending the streamer's camera (browser streams)
  status      String      @default("live") // live | ended
  startedAt   DateTime    @default(now())
  endedAt     DateTime?
  lastBeat    DateTime    @default(now()) // the streamer's page checks in every few seconds
  peakViewers Int         @default(0)
  endedBy     String      @default("") // "" | "admin"
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  watches     LiveWatch[]
  chats       LiveChat[]

  @@index([status, startedAt])
  @@index([userId, startedAt])
}

model LiveWatch {
  id       String     @id @default(cuid())
  streamId String
  userId   String
  lastSeen DateTime   @default(now())
  stream   LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([streamId, userId])
  @@index([streamId, lastSeen])
}

model LiveChat {
  id        String     @id @default(cuid())
  streamId  String
  userId    String
  body      String
  superCoins Int       @default(0) // Super Chat: coins paid to highlight and pin it
  createdAt DateTime   @default(now())
  stream    LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([streamId, createdAt])
}

// A like (+1) or dislike (-1) on anything in the news feed. `key` names the item the same way
// the feed does: p-<post>, b-<bulletin>, ph-<photo>, v-<video>, s-<user>-<time> (profile song),
// f-<friendship>, sv-<survey answer>, bl-<blog post>, gp-<group post>. One per person per item.
model Reaction {
  id        String   @id @default(cuid())
  key       String
  userId    String
  value     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, userId])
  @@index([key])
}

// An emoji reaction (one per person per item) on anything in the news feed. Same keys as Reaction.
model EmojiReaction {
  id        String   @id @default(cuid())
  key       String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([key, userId])
  @@index([key])
}

// A comment on a news-feed item that has no comments of its own (bulletins, photos, videos,
// profile songs, survey answers, new frenz). Same keys as Reaction. Replies are one level deep.
model ItemComment {
  id        String   @id @default(cuid())
  key       String
  authorId  String
  body      String
  parentId  String?
  createdAt DateTime @default(now())
  editedAt  DateTime? // set when the author edits it

  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  ItemComment?  @relation("itemCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ItemComment[] @relation("itemCommentReplies")

  @@index([key, createdAt])
}

// In-site notifications (the 🔔 list). Everything that goes out as a phone notification is saved here too.
// Alerts with the same tag (e.g. likes on one post) collapse into one row while unread.
model Alert {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String   @default("")
  url       String   @default("/home")
  tag       String?
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, seen])
}

// A virtual gift (bought with coins) sent to a member, on a post, feed item, comment,
// their profile (u-<user>) or their live stream (l-<stream>). Same keys as Reaction.
model Gift {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  key       String
  gift      String // slug from lib/gifts.js
  coins     Int
  createdAt DateTime @default(now())

  from User @relation("giftFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("giftTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([toId, createdAt])
  @@index([fromId, createdAt])
}

// Usernames someone used before. Old profile links and @mentions redirect to their new name.
model UsernameHistory {
  old       String   @id
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
