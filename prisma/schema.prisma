generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  username     String @unique
  email        String @unique
  passwordHash String
  displayName  String

  headline String @default("")
  mood     String @default("")
  gender   String @default("")
  age      Int?
  location String @default("")

  aboutMe          String @default("")
  meet             String @default("")
  interestsGeneral String @default("")
  interestsMusic   String @default("")
  interestsMovies  String @default("")
  interestsTv      String @default("")
  interestsBooks   String @default("")
  interestsHeroes  String @default("")

  customCss  String @default("")
  avatarUrl  String @default("")
  songUrl    String @default("")
  songTitle  String @default("")
  songArtist String @default("")

  profileViews   Int       @default(0)
  lastSeen       DateTime?
  createdAt      DateTime  @default(now())
  sessionVersion Int       @default(0) // bumped on password reset to log out old sessions

  // ---- money features ----
  theme              String    @default("") // slug of the shop theme applied to the profile
  aboutTemplate      String    @default("") // slug of the About Me template whose styles are applied
  aboutMeBackup      String    @default("") // their About Me from before they applied a template
  nameColor          String    @default("") // Supporter perk
  isArtist           Boolean   @default(false)
  genre              String    @default("")
  artistPro          Boolean   @default(false) // paid Pro Artist badge
  stripeCustomerId   String?
  stripeSubscription String?
  supporterUntil     DateTime? // Supporter perks active while this is in the future
  featuredUntil      DateTime? // paid "Featured" spot in Cool New People
  songBoostUntil     DateTime? // paid spot in Featured Music
  bonusSupporterUntil DateTime? // free Supporter time earned from invites

  // ---- invites + moderation ----
  referredById String? // who invited this member (signup?ref=username)
  bannedAt     DateTime? // suspended by an admin: can't log in, profile hidden
  banReason    String    @default("")

  passwordResets PasswordReset[]
  purchases      Purchase[]

  @@index([stripeSubscription])
  @@index([referredById])

  sentRequests     Friendship[] @relation("requester")
  receivedRequests Friendship[] @relation("addressee")
  topFriends       TopFriend[]  @relation("owner")
  inTopOf          TopFriend[]  @relation("friend")
  commentsReceived Comment[]    @relation("profile")
  commentsWritten  Comment[]    @relation("author")
  bulletins        Bulletin[]
  sentMessages     Message[]    @relation("sender")
  receivedMessages Message[]    @relation("recipient")
  photos           Photo[]
  blocksMade       Block[]      @relation("blocker")
  blocksReceived   Block[]      @relation("blocked")
  reportsMade      Report[]     @relation("reporter")
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("PENDING") // PENDING | ACCEPTED
  createdAt   DateTime @default(now())

  requester User @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model TopFriend {
  id       String @id @default(cuid())
  userId   String
  friendId String
  position Int

  user   User @relation("owner", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("friend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, position])
}

model Comment {
  id        String   @id @default(cuid())
  profileId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  profile User @relation("profile", fields: [profileId], references: [id], onDelete: Cascade)
  author  User @relation("author", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

model Bulletin {
  id             String    @id @default(cuid())
  authorId       String
  subject        String
  body           String
  createdAt      DateTime  @default(now())
  sponsoredUntil DateTime? // paid: shown to every member, labeled "Sponsored"

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([sponsoredUntil])
}

model Message {
  id               String   @id @default(cuid())
  senderId         String
  recipientId      String
  subject          String
  body             String
  read             Boolean  @default(false)
  senderDeleted    Boolean  @default(false)
  recipientDeleted Boolean  @default(false)
  createdAt        DateTime @default(now())

  sender    User @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  url       String
  caption   String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Purchase {
  id              String   @id @default(cuid())
  userId          String
  kind            String // theme | supporter | pro_artist | feature | song_boost | sponsor_bulletin | tip
  itemId          String   @default("") // theme slug or bulletin id
  amountCents     Int
  stripeSessionId String   @unique
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id           String    @id @default(cuid())
  reporterId   String
  kind         String // profile | comment | bulletin | message | photo
  targetId     String // id of the reported thing (the user id for a profile)
  targetUserId String // who posted it
  reason       String
  details      String    @default("")
  status       String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedBy   String    @default("")
  note         String    @default("")

  reporter User @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([targetUserId])
}
